{
  "name": "kawakami-lab",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/fortune-csv.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/fortune-csv.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "data:generate": "node scripts/fortune-csv.mjs",
    "data:check": "node scripts/fortune-csv.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run data:check && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "next": "15.4.10",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.7",
    "typescript": "^5"
  }
}
